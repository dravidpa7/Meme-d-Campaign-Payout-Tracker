NODE_ENV=development
PORT=4000
# Transactions need a replica set. Local docker-compose: see below. Atlas free tier works as-is.
MONGO_URI=mongodb://localhost:27017/memed?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Optional: leave empty to run without the Redis cache
REDIS_URL= 
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
